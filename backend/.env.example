# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database
MONGO_URI=mongodb://127.0.0.1:27017/p2p-rental

# JWT Configuration
ACCESS_TOKEN_SECRET=your_super_secret_access_token_key_here_12345
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_SECRET=your_super_secret_refresh_token_key_here_54321
REFRESH_TOKEN_EXPIRY=7d

# SMTP Email Configuration (Optional - falling back to simulated logs if left empty)
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USER=your_smtp_user_key
EMAIL_PASS=your_smtp_password_key
FROM_NAME="PeerRental Marketplace"
FROM_EMAIL=noreply@peerrental.com

# Cloudinary Configuration (Optional - falling back to local storage if left empty)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
